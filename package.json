{
  "name": "agentgdb",
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive Time-Travel Debugger and Replay Proxy for AI Agent Loops",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.2"
    }
  },
  "main": "src/server.js",
  "bin": {
    "agentgdb": "./bin/agentgdb.js",
    "agentgdb-mcp": "./bin/agentgdb-mcp.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "build:css": "tailwindcss -i src/styles.css -o public/tailwind.css --minify",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.6",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tailwindcss/cli": "^4.1.10",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.1",
    "diff": "^9.0.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "sqlite3": "^6.0.1",
    "ws": "^8.22.1",
    "tailwindcss": "^4.1.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  }
}
